# The exact Unreal Engine this project builds with (ADR-0001).
# Read by Tools/lib/common.sh. Changing it is a decision: record it in an ADR.
GRIDLANDS_UE_VERSION=5.8.3
GRIDLANDS_UE_ASSOCIATION=5.8
# Build changelist from Engine/Build/Build.version. Filled once by
# `Tools/doctor.sh --record-pin` after the engine is installed; empty = pin incomplete.
GRIDLANDS_UE_CHANGELIST=58210709
GRIDLANDS_UE_DEFAULT_ROOT=/pehverse/engines/UE_5.8.3
