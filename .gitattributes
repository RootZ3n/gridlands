# Unreal binary assets go through Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
Content/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Content/**/*.png filter=lfs diff=lfs merge=lfs -text
Content/**/*.wav filter=lfs diff=lfs merge=lfs -text

# Text that must stay LF for the Linux toolchain
*.sh   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.ini  text eol=lf
